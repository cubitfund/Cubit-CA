# Copy to .env — NEVER commit a filled .env (no keys in the repository).
# RPC endpoints of the scripts and fork tests.
SEPOLIA_RPC_URL=https://<sepolia rpc endpoint>
SEPOLIA_WS_URL=wss://<sepolia websocket endpoint>
MAINNET_RPC_URL=https://<mainnet rpc endpoint>
MAINNET_WS_URL=wss://<mainnet websocket endpoint>
ETHERSCAN_API_KEY=
# Deploy parameters (all immutable after deploy)
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543   # Sepolia; mainnet = 0x000000000004444c5dc75cB358380D2e3dE08A90
TEAM_ADDRESS=
# Launch FDV in wei (3.75 ETH): the 80% band holds 3 ETH of depth at the launch price.
LAUNCH_FDV_WEI=3750000000000000000
# Launch fee of the public Forge (script/LaunchpadDeploy.s.sol): 0.005 ETH, paid to the governance vault, never refunded.
FORGE_LAUNCH_FEE_WEI=5000000000000000
# Dev buy inside the atomic launch, taxed 3% like any buyer and not locked. 0.1 ETH buys 526,108 CUBIT
# on the fresh pool at a 3.75 ETH FDV; the minimum below leaves about 1% of slippage.
INITIAL_BUY_WEI=100000000000000000
INITIAL_BUY_MIN_CUBIT=520000000000000000000000
# Signing: use `--account <keystore>` or `--ledger`; PRIVATE_KEY is only for throwaway testnet wallets
PRIVATE_KEY=
